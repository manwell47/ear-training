121:   setActiveBand(index) {
122:     if (!this.visualizer || !this.visualizer.interactiveNodes) return;
123:     
124:     this.visualizer.activeNodeIndex = index;
125:     
126:     // Update active class on DOM tabs
127:     document.querySelectorAll('.btn-band').forEach(btn => {
128:         if (parseInt(btn.getAttribute('data-band')) === index) {
129:             btn.classList.add('active');
130:         } else {
131:             btn.classList.remove('active');
132:         }
133:     });
134:     
135:     // Update DOM inputs to match this node
136:     const node = this.visualizer.interactiveNodes[index];
137:     if (node) {
138:         this.updateManualInputs(node.frequencyHz, node.gainDb, node.qFactor);
139:         const typeSelect = document.getElementById('typeSelect');
140:         if (typeSelect) typeSelect.value = node.type || 'peaking';
141:     }
142:   }
