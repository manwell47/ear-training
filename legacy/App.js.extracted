81:   /**
82:    * Controls onboarding overlay workflow visibility.
83:    * @param {'WELCOME'|'MODULE_SELECT'|'DIFFICULTY_SELECT'|'PLAYING'} newState 
84:    */
85:   setAppState(newState) {
86:     const overlay = document.getElementById('onboardingOverlay');
87:     const screenWelcome = document.getElementById('screenWelcome');
88:     const screenModuleSelect = document.getElementById('screenModuleSelect');
89:     const screenDifficultySelect = document.getElementById('screenDifficultySelect');
90: 
91:     [screenWelcome, screenModuleSelect, screenDifficultySelect].forEach(s => {
92:       if (s) {
93:         s.classList.remove('active-step');
94:         s.classList.add('hidden');
95:       }
96:     });
97: 
98:     if (newState === 'WELCOME') {
99:       if (overlay) overlay.classList.remove('hidden-overlay');
100:       if (screenWelcome) {
101:         screenWelcome.classList.remove('hidden');
102:         setTimeout(() => screenWelcome.classList.add('active-step'), 20);
103:       }
104:     } else if (newState === 'MODULE_SELECT') {
105:       if (overlay) overlay.classList.remove('hidden-overlay');
106:       if (screenModuleSelect) {
107:         screenModuleSelect.classList.remove('hidden');
108:         setTimeout(() => screenModuleSelect.classList.add('active-step'), 20);
109:       }
110:     } else if (newState === 'DIFFICULTY_SELECT') {
111:       if (overlay) overlay.classList.remove('hidden-overlay');
112:       if (screenDifficultySelect) {
113:         screenDifficultySelect.classList.remove('hidden');
114:         setTimeout(() => screenDifficultySelect.classList.add('active-step'), 20);
115:       }
116:     } else if (newState === 'PLAYING') {
117:       if (overlay) overlay.classList.add('hidden-overlay');
118:     }
119:   }
