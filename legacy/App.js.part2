105:   /**
106:    * Phase 4: Dynamically generates track selector dropdown mapping AUDIO_SOURCES with <optgroup>.
107:    */
108:   populateSourceDropdown() {
109:     const select = document.getElementById('sourceSelect');
110:     if (!select) return;
111:     select.innerHTML = '';
112: 
113:     const categories = Array.from(new Set(AUDIO_SOURCES.map(t => t.category)));
114: 
115:     categories.forEach(catName => {
116:       const optgroup = document.createElement('optgroup');
117:       optgroup.label = catName;
118: 
119:       const tracks = AUDIO_SOURCES.filter(t => t.category === catName);
120:       tracks.forEach(track => {
121:         const opt = document.createElement('option');
122:         opt.value = track.id;
123:         opt.textContent = track.displayName;
124:         optgroup.appendChild(opt);
125:       });
126: 
127:       select.appendChild(optgroup);
128:     });
129: 
130:     const uploadGroup = document.createElement('optgroup');
131:     uploadGroup.label = "Archivos del Usuario";
132:     const uploadOpt = document.createElement('option');
133:     uploadOpt.value = 'upload-custom';
134:     uploadOpt.textContent = '📁 Cargar Archivo OGG / MP3...';
135:     uploadGroup.appendChild(uploadOpt);
136:     select.appendChild(uploadGroup);
137:   }
